{
  "name": "chatgpt-images-mcp",
  "version": "0.1.0",
  "description": "MCP server for Claude Code and Codex that generates images with your own signed-in ChatGPT account. No OpenAI API key needed.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "image-generation",
    "claude-code",
    "codex"
  ],
  "author": "Meet Patel",
  "license": "MIT",
  "homepage": "https://github.com/meet244/ChatGPT-Images-MCP#readme",
  "bugs": {
    "url": "https://github.com/meet244/ChatGPT-Images-MCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meet244/ChatGPT-Images-MCP.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/*.js",
    "npm-shrinkwrap.json",
    "CHANGELOG.md"
  ],
  "bin": {
    "chatgpt-images-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js serve",
    "dev": "tsx src/index.ts serve",
    "login": "tsx src/index.ts login",
    "setup": "tsx src/index.ts setup",
    "paste-cookies": "tsx src/index.ts paste-cookies",
    "import-cookies": "tsx src/index.ts import-cookies",
    "accounts": "tsx src/index.ts accounts",
    "accounts:manage": "tsx src/index.ts manage-accounts",
    "account:add": "tsx src/index.ts account-add",
    "account:use": "tsx src/index.ts account-use",
    "status": "tsx src/index.ts status",
    "browser": "tsx src/index.ts browser",
    "browser:manual": "tsx src/index.ts browser-manual",
    "browser:close": "tsx src/index.ts browser-close",
    "pretest": "npm run build",
    "test": "tsx --import ./test/support/headless.mjs --test test/*.test.ts",
    "pretest:live": "npm run build",
    "test:live": "node --import ./test/support/headless.mjs scripts/test-live.mjs",
    "recover": "tsx src/index.ts recover",
    "check": "tsc --noEmit",
    "browser:install": "playwright install chromium",
    "browser:install:webkit": "playwright install webkit",
    "cli": "node dist/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "playwright": "^1.63.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

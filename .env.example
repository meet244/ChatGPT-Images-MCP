# All relative paths resolve from the project directory, even when launched by an MCP client.
# Existing session is account default; named profiles are stored under accounts/<name> here.
# Manage profiles with npm run account:add / account:use / accounts.
CHATGPT_DATA_DIR=.chatgpt-images
CHATGPT_HEADLESS=false
# CDP opens installed Chrome separately and reuses it across MCP restarts.
# Cookie setup opens ordinary Chrome for verification, then reconnects controlled Chrome after you fully quit it.
CHATGPT_BROWSER_MODE=cdp
# Alternative engine with the same MCP tools: webkit (install with npm run browser:install:webkit).
# Optional nonstandard Chrome installation:
# CHATGPT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional browser-exported cookie JSON or Playwright storage state. Prefer importing once via CLI.
# CHATGPT_COOKIES_FILE=/absolute/path/to/cookies.json
# Only used with CHATGPT_BROWSER_MODE=playwright:
# CHATGPT_BROWSER_CHANNEL=chrome
CHATGPT_TIMEOUT_MS=300000
CHATGPT_POLL_MS=2000
# Optional overrides when ChatGPT's interface changes:
# CHATGPT_COMPOSER_SELECTOR=#prompt-textarea
# CHATGPT_SEND_SELECTOR=button[data-testid="send-button"]
# CHATGPT_ASSISTANT_SELECTOR=[data-message-author-role="assistant"]
# CHATGPT_IMAGE_SELECTOR=img
# CHATGPT_FILE_INPUT_SELECTOR=input[type="file"][accept*="image"]
# CHATGPT_ATTACHMENT_PREVIEW_SELECTOR=.composer-attachment-surface img
# CHATGPT_UPLOAD_PROGRESS_SELECTOR=[role="progressbar"][aria-label^="Uploading"]
